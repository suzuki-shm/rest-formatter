{
  "name": "rest-formatter",
  "displayName": "REST Formatter",
  "description": "REST Formatter for Visual Studio Code",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/suzuki-shm/rest-formatter"
  },
  "publisher": "ShinyaSuzuki",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:rest",
    "onLanguage:http"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [],
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "Http",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ]
      }
    ],
    "formatters": [
      {
        "language": "http",
        "displayName": "REST Formatter",
        "id": "rest-formatter"
      }
    ],
    "configuration": {
      "title": "REST Formatter",
      "properties": {
        "rest-formatter.header.indent": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "description": "Number of spaces to indent headers."
        },
        "rest-formatter.body.json.indent": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of spaces to indent the root of the JSON body."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && cp -r src/test/fixtures out/test/",
    "package:vsix": "vsce package",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "security:audit": "npm audit && npm audit --omit=dev"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.5",
    "sinon": "^21.1.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  }
}
